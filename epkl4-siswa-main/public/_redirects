# Proxy API ke Netlify Function epkl-api (netlify/functions/epkl-api.mjs) —
# function menyuntikkan header ngrok-skip-browser-warning SECARA SERVER-SIDE,
# jadi interstitial ngrok tidak pernah tersentuh browser dan tidak ada CORS.
# Satu URL untuk semua:
#   UI  : https://epkl-orzu.netlify.app
#   API : https://epkl-orzu.netlify.app/api/*  ->  function -> ngrok -> PC
/api/*  /.netlify/functions/epkl-api/:splat  200!

# SPA fallback: semua route yang tidak punya file HTML dilayani index.html
# (aplikasi memakai mode SPA ssr:false — navigasi ditangani Vue Router)
/*    /index.html   200
